    | SRA x =>
      obtain ⟨rd, rs1, rs2⟩ := x
      simp only [toSail, Option.some.injEq] at hi; subst hi
      exact dec_sra h rd rs1 rs2
    | SLLI x =>
      obtain ⟨rd, rs1, sh⟩ := x
