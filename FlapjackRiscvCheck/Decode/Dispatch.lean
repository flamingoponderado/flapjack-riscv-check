      exact dec_xor h rd rs1 rs2
    | SLTU x =>
      obtain ⟨rd, rs1, rs2⟩ := x
      simp only [toSail, Option.some.injEq] at hi; subst hi
      exact dec_sltu h rd rs1 rs2
    | _ => simp [toSail] at hi
  | Shift a =>
    cases a with
    | SLL x =>
      obtain ⟨rd, rs1, rs2⟩ := x
      simp only [toSail, Option.some.injEq] at hi; subst hi
