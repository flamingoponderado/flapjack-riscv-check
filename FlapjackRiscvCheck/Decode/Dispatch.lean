    | _ => simp [toSail] at hi
  | ArithI a =>
    cases a with
    | ADDI x =>
      obtain ⟨rd, rs1, imm⟩ := x
      exact decode_encode_addi rd rs1 imm
    | ANDI x =>
      obtain ⟨rd, rs1, imm⟩ := x
