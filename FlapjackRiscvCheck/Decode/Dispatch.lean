  cases i with
  | ArithR a =>
    cases a with
    | ADD x =>
      obtain ⟨rd, rs1, rs2⟩ := x
      exact decode_encode_add rd rs1 rs2
    | SUB x =>
      obtain ⟨rd, rs1, rs2⟩ := x
      exact decode_encode_sub rd rs1 rs2
    | AND x =>
      obtain ⟨rd, rs1, rs2⟩ := x
      exact decode_encode_and rd rs1 rs2
    | OR x =>
      obtain ⟨rd, rs1, rs2⟩ := x
      exact decode_encode_or rd rs1 rs2
    | XOR x =>
      obtain ⟨rd, rs1, rs2⟩ := x
      exact decode_encode_xor rd rs1 rs2
    | SLTU x =>
      obtain ⟨rd, rs1, rs2⟩ := x
      exact decode_encode_sltu rd rs1 rs2
    | _ => simp [toSail] at hi
  | Shift a =>
    cases a with
    | SLL x =>
      obtain ⟨rd, rs1, rs2⟩ := x
      exact decode_encode_sll rd rs1 rs2
    | SRL x =>
      obtain ⟨rd, rs1, rs2⟩ := x
      exact decode_encode_srl rd rs1 rs2
    | SRA x =>
      obtain ⟨rd, rs1, rs2⟩ := x
      exact decode_encode_sra rd rs1 rs2
    | SLLI x =>
      obtain ⟨rd, rs1, sh⟩ := x
      exact decode_encode_slli rd rs1 sh
    | SRLI x =>
      obtain ⟨rd, rs1, sh⟩ := x
