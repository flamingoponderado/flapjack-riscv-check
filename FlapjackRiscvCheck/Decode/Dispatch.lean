      obtain ⟨rd, rs1, rs2⟩ := x
      simp only [toSail, Option.some.injEq] at hi; subst hi
      exact dec_and h rd rs1 rs2
    | OR x =>
      obtain ⟨rd, rs1, rs2⟩ := x
      simp only [toSail, Option.some.injEq] at hi; subst hi
      exact dec_or h rd rs1 rs2
    | XOR x =>
      obtain ⟨rd, rs1, rs2⟩ := x
