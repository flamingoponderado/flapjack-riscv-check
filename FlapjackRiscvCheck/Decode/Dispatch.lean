  cases i with
  | ArithR a =>
    cases a with
    | ADD x =>
      obtain ⟨rd, rs1, rs2⟩ := x
      rw [enc_add rd rs1 rs2]
      omega
    | SUB x =>
      obtain ⟨rd, rs1, rs2⟩ := x
      rw [enc_sub rd rs1 rs2]
      omega
    | AND x =>
      obtain ⟨rd, rs1, rs2⟩ := x
