    | SRAI x =>
      obtain ⟨rd, rs1, sh⟩ := x
      exact decode_encode_srai rd rs1 sh
    | _ => simp [toSail] at hi
  | MulDiv a =>
    cases a with
    | MUL x =>
      obtain ⟨rd, rs1, rs2⟩ := x
      exact decode_encode_mul rd rs1 rs2
    | MULHU x =>
      obtain ⟨rd, rs1, rs2⟩ := x
      exact decode_encode_mulhu rd rs1 rs2
    | DIV x =>
      obtain ⟨rd, rs1, rs2⟩ := x
