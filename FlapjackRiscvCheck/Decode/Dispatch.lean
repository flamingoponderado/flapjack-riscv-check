    | AUIPC x =>
      obtain ⟨rd, imm⟩ := x
      exact decode_encode_auipc rd imm
    | _ => simp [toSail] at hi
  | Load a =>
    cases a with
    | LD x =>
      obtain ⟨rd, rs1, imm⟩ := x
      exact decode_encode_ld rd rs1 imm
    | LWU x =>
      obtain ⟨rd, rs1, imm⟩ := x
