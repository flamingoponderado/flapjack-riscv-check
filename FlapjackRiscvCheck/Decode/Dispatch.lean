      exact dec_lwu h rd rs1 imm
    | LHU x =>
      obtain ⟨rd, rs1, imm⟩ := x
      simp only [toSail, Option.some.injEq] at hi; subst hi
      exact dec_lhu h rd rs1 imm
    | LBU x =>
