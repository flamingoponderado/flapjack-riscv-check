    runSail (ext_decode (Encode i)) t = some (si, t) := by
  unfold ext_decode
  cases i with
  | ArithR a =>
    cases a with
    | ADD x =>
      obtain ⟨rd, rs1, rs2⟩ := x
      simp only [toSail, Option.some.injEq] at hi; subst hi
      exact dec_add h rd rs1 rs2 hh
    | SUB x =>
      obtain ⟨rd, rs1, rs2⟩ := x
      simp only [toSail, Option.some.injEq] at hi; subst hi
      exact dec_sub h rd rs1 rs2
